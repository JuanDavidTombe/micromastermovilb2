# Backend Laravel de MicroMaster Web (D:\Sprint\Micromaster\backend)
# Rutas reales: /api/auth/login, /api/dashboard, /api/delivery/orders...
# Copia este archivo a .env y ajusta la IP de tu PC.
#
# Equipo físico (Expo Go): http://TU_IP_LOCAL:8000/api
#   - Windows: ipconfig → IPv4 (ej. 192.168.1.10)
#   - macOS:   ipconfig getifaddr en0
# Emulador Android: http://10.0.2.2:8000/api
# Emulador iOS:     http://localhost:8000/api
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api
