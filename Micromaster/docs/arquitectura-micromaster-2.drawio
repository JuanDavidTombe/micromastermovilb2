        <mxCell id="t1" value="MICROMASTER — ARQUITECTURA REAL &#183; Laravel API (backend/) + React Web / Expo (frontend/)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#F5F5F5;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="5 áreas de izquierda a derecha: Rutas → Controladores → Modelos → Base de Datos · cliente API abajo al centro · lienzo modo oscuro #1E1E1E" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#9CA3AF;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1100" height="20" as="geometry" />
