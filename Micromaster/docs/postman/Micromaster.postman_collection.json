    {
      "name": "02 · Inventario & Stock (lectura)",
      "item": [
        {
          "name": "Listar Lotes FEFO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().summary;",
                  "console.log('ocupacion:', s.occupancy + '%', '| bajo minimo:', s.low_stock.length, '| quiebre:', s.rupture.length);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
