    {
      "name": "03 · Inventario & Stock (escritura)",
      "item": [
        {
          "name": "Entrada de Stock (Calidad OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.environment.set('batchId', j.batch.id);",
                  "console.log('lote creado:', j.batch.batch_code, '| zona:', j.batch.storage_zone);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingredient_id\": 1,\n  \"batch_code\": \"POSTMAN-{{$timestamp}}\",\n  \"supplier_name\": \"Proveedor Postman S.A.\",\n  \"quantity\": 25,\n  \"expiration_date\": \"2027-06-30\",\n  \"storage_zone\": \"A-01\",\n  \"purchase_order_code\": \"OC-2026-001\",\n  \"quality_checklist\": {\n    \"temperature\": true,\n    \"packaging\": true,\n    \"labeling\": true,\n    \"sanitary_registry\": true\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/stock/entry", "host": ["{{baseUrl}}"], "path": ["api", "stock", "entry"] }
          }
        },
        {
          "name": "Entrada rechazada por Calidad (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
                  "pm.test('Motivo = QUALITY_REJECTED', () => pm.expect(pm.response.json().error).to.eql('QUALITY_REJECTED'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingredient_id\": 1,\n  \"batch_code\": \"POSTMAN-FAIL-{{$timestamp}}\",\n  \"quantity\": 5,\n  \"expiration_date\": \"2027-06-30\",\n  \"storage_zone\": \"A-01\",\n  \"quality_checklist\": {\n    \"temperature\": true,\n    \"packaging\": false,\n    \"labeling\": true,\n    \"sanitary_registry\": true\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/stock/entry", "host": ["{{baseUrl}}"], "path": ["api", "stock", "entry"] }
          }
        },
        {
          "name": "Bloquear Lote (cuarentena)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Lote en cuarentena', () => pm.expect(j.batch.is_quarantined).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_quarantined\": true,\n  \"quarantine_reason\": \"Prueba Postman: empaque danado\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/stock/batches/{{batchId}}/block",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock", "batches", "{{batchId}}", "block"]
            }
          }
        },
        {
          "name": "Liberar Lote (quitar cuarentena)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Lote liberado', () => pm.expect(j.batch.is_quarantined).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_quarantined\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/stock/batches/{{batchId}}/block",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock", "batches", "{{batchId}}", "block"]
            }
          }
        }
      ]
    },
