          "name": "Cruce Orden de Compra (OC-2026-001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('OC encontrada', () => pm.expect(j.found).to.be.true);",
