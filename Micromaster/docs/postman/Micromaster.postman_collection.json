              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/stock/entry", "host": ["{{baseUrl}}"], "path": ["api", "stock", "entry"] }
          }
        },
        {
          "name": "CONTADOR intenta ver stock (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 - modulo no autorizado', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{contadorToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/stock/batches", "host": ["{{baseUrl}}"], "path": ["api", "stock", "batches"] }
          }
        },
        {
          "name": "SUPERVISOR lee stock (200, solo lectura)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 - read_module inventory_stock', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{produccionToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/stock/batches", "host": ["{{baseUrl}}"], "path": ["api", "stock", "batches"] }
          }
