<mxfile host="app.diagrams.net" agent="Micromaster" pages="2">
  <diagram id="arquitectura" name="1. Arquitectura General">
    <mxGraphModel dx="2302" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" value="MICROMASTER B2B — ARQUITECTURA: React + Laravel + App Móvil" vertex="1">
          <mxGeometry height="30" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" value="Tres clientes · un solo API. Todo se comunica por HTTP + JSON con token Bearer." vertex="1">
          <mxGeometry height="20" width="760" x="40" y="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flujo-peticion" name="2. Flujo de una petición">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="990" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="FLUJO DE UNA PETICIÓN · GET /api/admin/pending-users (rol ADMINISTRADOR)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="El mismo recorrido lo hace React y lo hará la app móvil: la única diferencia es dónde se guarda el token." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="REACT / APP MÓVIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#61DAFB;strokeColor=#087EA4;fontColor=#0B2A33;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L1l" style="rounded=0;html=1;fillColor=#D1D5DB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="169" y="150" width="2" height="440" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="APACHE (proxy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D22128;strokeColor=#8B1519;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L2l" style="rounded=0;html=1;fillColor=#D1D5DB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="449" y="150" width="2" height="440" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="MIDDLEWARE (5 capas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF2D20;strokeColor=#B01E16;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L3l" style="rounded=0;html=1;fillColor=#D1D5DB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="729" y="150" width="2" height="440" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="CONTROLADOR + MODELO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF2D20;strokeColor=#B01E16;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L4l" style="rounded=0;html=1;fillColor=#D1D5DB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1009" y="150" width="2" height="440" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="MySQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00758F;strokeColor=#004B63;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="100" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L5l" style="rounded=0;html=1;fillColor=#D1D5DB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1289" y="150" width="2" height="440" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="1. GET /api/admin/pending-users · Authorization: Bearer 1|abc..." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#087EA4;fontColor=#0B2A33;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="180" as="sourcePoint" />
            <mxPoint x="450" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a2" value="2. ProxyPass /api → http://127.0.0.1:8080/api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B1519;fontColor=#111111;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="240" as="sourcePoint" />
            <mxPoint x="730" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a3" value="3. throttle → sanctum → write.guard → role → module.permission  —  5/5 OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B01E16;fontColor=#111111;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="310" as="sourcePoint" />
            <mxPoint x="1010" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a4" value="4. SELECT * FROM users WHERE status = &#39;PENDING&#39; ORDER BY created_at" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#00758F;fontColor=#004B63;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1010" y="380" as="sourcePoint" />
            <mxPoint x="1290" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a5" value="5. 3 filas (usuarios en PENDING)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#00758F;fontColor=#004B63;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1290" y="430" as="sourcePoint" />
            <mxPoint x="1010" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a6" value="6. response()-&gt;json([users, pending], 200)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2937;fontColor=#1F2937;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1010" y="480" as="sourcePoint" />
            <mxPoint x="450" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a7" value="7. 200 OK · application/json" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2937;fontColor=#1F2937;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="540" as="sourcePoint" />
            <mxPoint x="170" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nmw" value="Detalle del middleware (se aplica en este orden antes de llegar al controlador)&#xa;throttle 10/min → 429  ·  auth:sanctum → 401 sin token  ·  write.guard → 403 rol solo lectura  ·  role → 403 rol no autorizado  ·  module.permission → 403 sin módulo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#7C2D12;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="470" y="610" width="930" height="75" as="geometry" />
        </mxCell>
        <mxCell id="nreg" value="El mismo recorrido sigue cualquier endpoint: registrar, aprobar una solicitud, crear una orden, subir la foto de perfil o escanear un QR." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="8. EL CLIENTE RECIBE EL JSON&#xa;• axios resuelve la promesa (response.data)&#xa;• setRows(res.data.users) actualiza el estado&#xa;• React vuelve a renderizar y la tabla se pinta&#xa;• Si sale 401, el interceptor borra el token y va a /login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#61DAFB;strokeColor=#087EA4;fontColor=#0B2A33;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="400" height="220" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="CASOS DE ERROR — se corta en cualquier línea y vuelve como JSON&#xa;• 401 Unauthenticated: token ausente o vencido → interceptor borra localStorage y redirige a /login&#xa;• 403 Forbidden: rol equivocado (RoleMiddleware / ModulePermissionMiddleware)&#xa;• 422 Validation Error: fallo de datos → axios lanza excepción y la página muestra data.errors&#xa;• 429 Too Many Requests: throttle en /auth/register (10 por minuto por IP)&#xa;• 403 &#39;Tu cuenta aún está pendiente de aprobación&#39;: status = PENDING, no se entrega token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#7C2D12;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="480" y="730" width="500" height="220" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="Dónde vive el token&#xa;WEB (React) → localStorage&#xa;• Login.jsx lo guarda con onLogin(user, token)&#xa;• api.js lo añade en el request interceptor&#xa;• 401 → lo borra y redirige a /login&#xa;MÓVIL → SecureStore / Keychain&#xa;• mismo esquema Bearer, distinto almacenamiento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1020" y="730" width="380" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
